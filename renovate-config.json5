{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Default sane automerge config for all repositories in this org",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":enableVulnerabilityAlerts",
        "schedule:daily",
        ":automergeMinor",
        ":automergeBranch",
        ":automergeRequireAllStatusChecks",
        "docker:enableMajor",
        ":enablePreCommit",
        ":labels(pr-deps)"
    ],
    "autoApprove": true,
    "minimumReleaseAge": "4 days",
    "ansible-galaxy": {
        "fileMatch": [
            "(^|/)(galaxy|requirements)(\.ansible|\.molecule)?\.ya?ml$"
        ]
    },
    "packageRules": [
        {
            "description": "Don't upgrade ansible-core since its used for explicit compat testing",
            "matchPackageNames": ["ansible-core"],
            "allowedVersions": "<{{major}}.{{add minor 1}}.0"
        }
    ]
}
